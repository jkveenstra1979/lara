# Supabase — eigen project, niet dat van Airspace_management.
# Kopieer naar .env.local en vul in met de waarden uit Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side: nodig voor de import-route, die buiten de gebruikerssessie
# om in datasets, airspaces en geometries schrijft. Nooit naar de client sturen.
SUPABASE_SERVICE_ROLE_KEY=
