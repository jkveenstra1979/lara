# Supabase — eigen project, niet dat van Airspace_management.
# Kopieer naar .env.local en vul in met de waarden uit Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alleen server-side: nodig voor de import-route, die buiten de gebruikerssessie
# om in datasets, airspaces en geometries schrijft. Nooit naar de client sturen.
SUPABASE_SERVICE_ROLE_KEY=

# Meldknop: maakt van een melding een issue in github.com/jkveenstra1979/lara.
# Een fine-grained token met alleen `Issues: write` op die repository is genoeg.
# Ontbreekt hij, dan verschijnt de knop niet en antwoordt /api/melding met 503.
GITHUB_TOKEN=
